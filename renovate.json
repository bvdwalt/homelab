{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "pinDigests": true,
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "minimumReleaseAge": null
  },
  "prHourlyLimit": 6,
  "schedule": ["* * * * *"],
  "assignees": ["bvdwalt"],
  "flux": {
    "managerFilePatterns": [
      "/(^|/)k8s/[^/]+/.+\\.yaml$/",
      "/(^|/)k8s/common/.+\\.yaml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/(^|/)k8s/[^/]+/.+\\.yaml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)images/[^/]+/Dockerfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+ARG \\S+_VERSION=(?<currentValue>\\S+)"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)k8s/[^/]+/.+\\.yaml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+- name: \\S+_VERSION\\s+value: (?<currentValue>\\S+)\\s+- name: \\S+_SHA256\\s+value: (?<currentDigest>[a-f0-9]{64})"
      ]
    }
  ],
  "hostRules": [
    {
      "matchHost": "docker.gitea.com",
      "hostType": "docker"
    },
    {
      "matchHost": "ghcr.io",
      "hostType": "docker",
      "authType": "Basic",
      "username": "bvdwalt",
      "password": "{{ secrets.GHCR_PAT }}"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/bvdwalt/order-pipeline/**"],
      "groupName": "order-pipeline",
      "sourceUrl": "https://github.com/bvdwalt/order-pipeline"
    },
    {
      "matchPackageNames": ["lscr.io/linuxserver/qbittorrent"],
      "allowedVersions": "/^5\\./"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["lscr.io/linuxserver/**"],
      "changelogUrl": "https://github.com/linuxserver/docker-{{ lookup (split packageName '/') 2 }}/releases"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "ghcr.io/bvdwalt/**",
        "!ghcr.io/bvdwalt/order-pipeline/**",
        "!ghcr.io/bvdwalt/homelab-*"
      ],
      "sourceUrl": "https://github.com/bvdwalt/{{ lookup (split packageName '/') 2 }}"
    },
    {
      "matchPackageNames": ["jellyfin/jellyfin"],
      "allowedVersions": "/^\\d+\\.\\d+(\\.\\d+)?$/",
      "sourceUrl": "https://github.com/jellyfin/jellyfin"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/bvdwalt/**", "ghcr.io/jigsmiths/**"],
      "minimumReleaseAge": null
    },
    {
      "matchDatasources": ["npm"],
      "matchPackageNames": ["@anthropic-ai/claude-code"],
      "minimumReleaseAge": null
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    },
    {
      "matchUpdateTypes": ["pin", "pinDigest", "digest", "patch"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "pin", "pinDigest", "digest"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Cluster-critical operators and infra stay manual",
      "matchFileNames": ["k8s/altair/infrastructure/releases/**", "k8s/altair/flux-system/**"],
      "automerge": false
    },
    {
      "matchManagers": ["terraform", "npm"],
      "automerge": false
    },
    {
      "matchPackageNames": ["fluxcd/flux2"],
      "matchUpdateTypes": ["pin", "pinDigest"],
      "enabled": false
    },
    {
      "matchPackageNames": ["aquasecurity/trivy"],
      "matchUpdateTypes": ["pin", "pinDigest"],
      "enabled": false
    }
  ]
}
