{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "pinDigests": true,
  "prHourlyLimit": 6,
  "schedule": ["* * * * *"],
  "assignees": ["bvdwalt"],
  "flux": {
    "managerFilePatterns": [
      "/(^|/)k8s/[^/]+/.+\\.yaml$/",
      "/(^|/)k8s/common/.+\\.yaml$/"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/(^|/)k8s/[^/]+/.+\\.yaml$/"
    ]
  },
  "hostRules": [
    {
      "matchHost": "docker.gitea.com",
      "hostType": "docker"
    },
    {
      "matchHost": "ghcr.io",
      "hostType": "docker",
      "authType": "Basic",
      "username": "bvdwalt",
      "password": "{{ secrets.GHCR_PAT }}"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/bvdwalt/order-pipeline/**"],
      "groupName": "order-pipeline",
      "sourceUrl": "https://github.com/bvdwalt/order-pipeline"
    },
    {
      "matchPackageNames": ["lscr.io/linuxserver/qbittorrent"],
      "allowedVersions": "/^5\\./"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["lscr.io/linuxserver/**"],
      "changelogUrl": "https://github.com/linuxserver/docker-{{ lookup (split packageName '/') 2 }}/releases"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "ghcr.io/bvdwalt/**",
        "!ghcr.io/bvdwalt/order-pipeline/**",
        "!ghcr.io/bvdwalt/homelab-*"
      ],
      "sourceUrl": "https://github.com/bvdwalt/{{ lookup (split packageName '/') 2 }}"
    },
    {
      "matchPackageNames": ["jellyfin/jellyfin"],
      "allowedVersions": "/^\\d+\\.\\d+(\\.\\d+)?$/",
      "sourceUrl": "https://github.com/jellyfin/jellyfin"
    },
    {
      "matchPackageNames": ["fluxcd/flux2"],
      "matchUpdateTypes": ["pin", "pinDigest"],
      "enabled": false
    },
    {
      "matchPackageNames": ["aquasecurity/trivy"],
      "matchUpdateTypes": ["pin", "pinDigest"],
      "enabled": false
    }
  ]
}
